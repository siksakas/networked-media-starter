<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Make POST</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <%- include('nav.ejs') %>
    <% for(let post of serverData){ %>
        <span><%= post.date %></span>
        <div class="individual-post">
            <%= post.caption %>
        </div>
    <% } %>
</body>
</html>